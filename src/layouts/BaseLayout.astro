---
import { canonicalFor } from '../lib/canonical';
// Self-hosted fonts (replaced the render-blocking Google Fonts @import in global.css).
import "@fontsource/cormorant-garamond/latin-300.css";
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/cormorant-garamond/latin-700.css";
import "@fontsource/cormorant-garamond/latin-300-italic.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "@fontsource/poppins/latin-300.css";
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource/poppins/latin-300-italic.css";
import "@fontsource/poppins/latin-400-italic.css";
import "@fontsource/qwitcher-grypen/latin-400.css";
import '../styles/global.css';
import { Navigation } from '../components/Navigation';
import { Footer } from '../components/Footer';
import { ScrollToTop } from '../components/ScrollToTop';
import PostHogAnalytics from '../components/PostHogAnalytics.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  // Error pages: emit robots noindex and skip the canonical link.
  noindex?: boolean;
}

const {
  title = "Daley Organics - Premium Organic Soil Solutions | Grants Pass, Oregon",
  description = "Premium organic soil, compost, mulch, and fertilizer blends from Daley Organics in Grants Pass, Oregon. Feed the microbes. Grow Bigger. Grow Better.",
  keywords = "organic soil mix Grants Pass Oregon, bulk organic fertilizer Rogue Valley, Daley's Mix premium growing media, organic compost Southern Oregon, worm castings, bat guano, kelp meal, mycorrhiza, glacial rock dust, organic gardening Grants Pass, soil amendments Oregon, bulk soil pickup Grants Pass",
  ogImage = "/images/hero-garden.jpg",
  ogType = "website",
  canonical = "",
  noindex = false,
} = Astro.props;

// Compute canonical from current page path if not explicitly provided
const canonicalUrl = canonical || canonicalFor(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph (Facebook / Instagram link previews) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://daleyorganics.com${ogImage}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Daley Organics" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://daleyorganics.com${ogImage}`} />

    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="US-OR" />
    <meta name="geo.placename" content="Grants Pass, Oregon" />
    <meta name="geo.position" content="42.5432168;-123.3884123" />
    <meta name="ICBM" content="42.5432168, -123.3884123" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Page-specific schema injected via head slot -->
    <slot name="head" />
    <PostHogAnalytics />
  </head>
  <body>
    <Navigation client:load />
    <slot />
    <Footer client:visible />
    <ScrollToTop client:load />
  </body>
</html>
