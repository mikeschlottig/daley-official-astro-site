---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeliveryHubSchema from '../../components/schema/DeliveryHubSchema.astro';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  title="Bulk Soil and Mulch Delivery | Daley Organics – Josephine County"
  description="Schedule delivery of premium organic soil, compost, mulch, and fertilizer across Grants Pass, Merlin, Murphy, Williams, and Rogue River. Call (541) 441-0510."
  keywords="bulk soil delivery Josephine County, organic soil delivery Grants Pass, mulch delivery Rogue Valley, compost delivery Southern Oregon, bulk fertilizer delivery"
  canonical={canonical}
>
  <DeliveryHubSchema slot="head" />

  <div class="bg-[#141414] min-h-screen pt-[72px]">
    <!-- Page Header -->
    <div class="bg-[#0e0e0e] border-b border-white/10 py-14">
      <div class="container-custom">
        <p class="eyebrow mb-4">Delivery Service</p>
        <h1 class="font-serif text-4xl md:text-5xl text-white mb-4">Bulk Soil &amp; Mulch Delivery</h1>
        <p class="text-white/60 max-w-2xl">Schedule flatbed and dump truck delivery of premium organic soil, compost, mulch, and fertilizer across Josephine County. Call <a href="tel:+15414410510" class="text-gold-400 hover:text-gold-300 transition-colors">(541) 441-0510</a>.</p>
      </div>
    </div>

    <!-- Delivery Areas -->
    <div class="container-custom py-16 max-w-4xl">

      <div class="mb-12">
        <h2 class="font-serif text-2xl text-white mb-4">Where We Deliver</h2>
        <p class="text-white/60 leading-relaxed mb-6">
          Daley Organics delivers bulk organic soils, multi-ingredient compost, landscape mulch, and complete organic fertilizer blends across Josephine County. Whether you're a farmer preparing beds in Murphy, a vineyard manager in Williams, or a homeowner in Grants Pass, our flatbed and dump truck service brings the same premium products available at our Monument Drive soil yard directly to your site.
        </p>
        <p class="text-white/60 leading-relaxed">
          Delivery is available for orders of 4 cubic yards or more. Smaller quantities are available for pickup at our soil yard — call ahead to schedule.
        </p>
      </div>

      <!-- Delivery Area Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-16">
        <a href="/delivery/murphy" class="group bg-white/5 border border-white/10 rounded-lg p-7 hover:border-gold-500/30 transition-all duration-300">
          <h3 class="font-serif text-xl text-white mb-2 group-hover:text-gold-400 transition-colors">Murphy, Oregon</h3>
          <p class="text-white/55 text-sm leading-relaxed mb-4">
            Premium organic planting soils, multi-ingredient compost, and bulk landscape mulch delivered directly to farms, vineyards, and residences in Murphy, Oregon.
          </p>
          <span class="inline-flex items-center gap-2 text-gold-400 text-sm group-hover:gap-3 transition-all">
            View Murphy Delivery Info
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        </a>

        <a href="/delivery/williams" class="group bg-white/5 border border-white/10 rounded-lg p-7 hover:border-gold-500/30 transition-all duration-300">
          <h3 class="font-serif text-xl text-white mb-2 group-hover:text-gold-400 transition-colors">Williams, Oregon</h3>
          <p class="text-white/55 text-sm leading-relaxed mb-4">
            Specialized 25-ingredient complete organic fertilizer, living topsoil blends, and premium compost delivered in bulk to Williams homesteads, farms, and permaculture operations.
          </p>
          <span class="inline-flex items-center gap-2 text-gold-400 text-sm group-hover:gap-3 transition-all">
            View Williams Delivery Info
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>

      <!-- What We Deliver -->
      <div class="mb-16">
        <h2 class="font-serif text-2xl text-white mb-6">What We Deliver</h2>
        <div class="grid md:grid-cols-3 gap-5">
          <div class="bg-white/5 border border-white/10 rounded-lg p-6">
            <h3 class="font-serif text-lg text-white mb-2">Soil Mixes</h3>
            <p class="text-white/55 text-sm leading-relaxed">Daley's Mix, Premium Soil Mix, and Merlin Blend — our three professional-grade growing media, each formulated with 20+ organic amendments and complete fertilizer blend.</p>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-lg p-6">
            <h3 class="font-serif text-lg text-white mb-2">Compost &amp; Mulch</h3>
            <p class="text-white/55 text-sm leading-relaxed">Premium Organic Compost for soil rehabilitation and garden bed establishment. Landscape mulch for weed suppression, moisture retention, and erosion control.</p>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-lg p-6">
            <h3 class="font-serif text-lg text-white mb-2">Fertilizer Blends</h3>
            <p class="text-white/55 text-sm leading-relaxed">Grow Blend 5-4-2 and Bloom Blend 2-7-7 — complete organic fertilizers with 25 ingredients each. Available in bulk bags and 2,000 lb totes.</p>
          </div>
        </div>
      </div>

      <!-- Delivery Process -->
      <div class="mb-16">
        <h2 class="font-serif text-2xl text-white mb-6">How Delivery Works</h2>
        <div class="space-y-4">
          <div class="flex gap-5 p-6 bg-white/5 rounded-lg border border-white/10">
            <div class="w-10 h-10 rounded-full bg-gold-500 flex items-center justify-center flex-shrink-0 font-black text-[#141414] text-lg">1</div>
            <div>
              <h3 class="font-serif text-lg text-white mb-1">Call for a Quote</h3>
              <p class="text-white/55 text-sm">Call <a href="tel:+15414410510" class="text-gold-400 hover:text-gold-300 transition-colors">(541) 441-0510</a> with your delivery address and order size. We'll provide a quote that includes product cost and delivery fee based on distance and load size.</p>
            </div>
          </div>
          <div class="flex gap-5 p-6 bg-white/5 rounded-lg border border-white/10">
            <div class="w-10 h-10 rounded-full bg-gold-500 flex items-center justify-center flex-shrink-0 font-black text-[#141414] text-lg">2</div>
            <div>
              <h3 class="font-serif text-lg text-white mb-1">Schedule Your Delivery</h3>
              <p class="text-white/55 text-sm">We'll coordinate a delivery window that works for you. Most deliveries within Josephine County can be scheduled within 3-5 business days. Larger orders and specialty blends may require additional lead time.</p>
            </div>
          </div>
          <div class="flex gap-5 p-6 bg-white/5 rounded-lg border border-white/10">
            <div class="w-10 h-10 rounded-full bg-gold-500 flex items-center justify-center flex-shrink-0 font-black text-[#141414] text-lg">3</div>
            <div>
              <h3 class="font-serif text-lg text-white mb-1">We Deliver &amp; Dump</h3>
              <p class="text-white/55 text-sm">Our flatbed or dump truck arrives at your site with your order. We can dump on driveways, in designated garden areas, or at a location you specify. Please ensure clear access for a large truck.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-gold-500/10 border border-gold-500/30 rounded-lg p-8 text-center">
        <h2 class="font-serif text-2xl text-white mb-3">Ready to Schedule Delivery?</h2>
        <p class="text-white/55 mb-6 max-w-lg mx-auto">Call us with your delivery address and product needs. We'll provide a quote and schedule your delivery.</p>
        <a href="tel:+15414410510" class="btn-primary rounded-sm inline-flex items-center gap-2 text-base px-10 py-4">
          Call (541) 441-0510
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
